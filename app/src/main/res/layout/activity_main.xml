<?xml version="1.0" encoding="utf-8"?>
<!-- 위에서 아래로: 오늘의 출석(남색 카드) → 할 일(버튼, 보충 안내) → 설정 목록 → 안내 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 계정 칩: 누르면 그 계정의 출석 카드·설정이 보인다 -->
        <HorizontalScrollView
            android:id="@+id/accountBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/accountChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@drawable/chip_gap"
                android:orientation="horizontal"
                android:showDividers="middle" />
        </HorizontalScrollView>

        <!-- 오늘의 출석 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/heroCard"
            android:background="@drawable/bg_hero">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-40dp"
                android:layout_marginEnd="-56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/hero_motif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/heroEyebrow"
                        style="@style/Text.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HoYoLAB 매일 출석체크" />

                    <TextView
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_done"
                        android:paddingVertical="5dp"
                        android:textColor="@color/on_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/heroDayRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/heroDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/hoyo_numerals"
                        android:includeFontPadding="false"
                        android:textColor="@color/gold"
                        android:textSize="72sp" />

                    <TextView
                        android:id="@+id/heroUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="일째"
                        android:textColor="@color/hero_ink"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heroMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/hero_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/heroStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/hero_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.HeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘 보상" />

                    <TextView
                        android:id="@+id/heroReward"
                        style="@style/Text.HeroValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.HeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="마지막 확인" />

                    <TextView
                        android:id="@+id/heroChecked"
                        style="@style/Text.HeroValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/heroNextRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.HeroLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다음 자동 출석" />

                    <TextView
                        android:id="@+id/heroNext"
                        style="@style/Text.HeroValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heroNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/primaryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="16sp" />

        <!-- 보충 출석 안내: 가능할 때만 보인다 -->
        <LinearLayout
            android:id="@+id/makeUpCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_make_up"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보충 출석을 할 수 있어요"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/makeUpText"
                    style="@style/Text.RowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/makeUpButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="보충하기"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:text="제때 출석하려면"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/timingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group"
                android:divider="@drawable/divider_inset"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/rowExactAlarm"
                    style="@style/Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="알람 및 리마인더 허용" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="하루가 바뀐 직후 정확한 시각에 출석해요. 허용하지 않으면 몇 분 늦을 수 있어요." />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="허용"
                        android:textColor="@color/accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowBattery"
                    style="@style/Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.RowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="배터리 최적화 제외" />

                        <TextView
                            style="@style/Text.RowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="절전 때문에 출석이 밀리거나 빠지지 않게 해요. 폰을 바꾼 뒤에도 다시 확인해 주세요." />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="허용"
                        android:textColor="@color/accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="리딤 코드"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/redeemGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:divider="@drawable/divider_inset"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:id="@+id/rowRedeem"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="리딤 코드 자동 입력" />

                    <TextView
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="호요랩 공식 목록과 커뮤니티 글에서 새 코드를 찾아 하루 한 번 입력해요" />
                </LinearLayout>

                <com.lesumein.hoyocheckin.StarSwitch
                    android:id="@+id/redeemSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRedeemRole"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보상 받을 캐릭터" />

                    <TextView
                        android:id="@+id/redeemRoleSub"
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRedeemNow"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="지금 코드 확인" />

                    <TextView
                        android:id="@+id/redeemSummary"
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="설정"
            android:textColor="@color/ink_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/settingsGroup"
            android:background="@drawable/bg_group"
            android:divider="@drawable/divider_inset"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:id="@+id/rowHistory"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보상 내역" />

                    <TextView
                        android:id="@+id/historySub"
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowMakeUpAlerts"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="보충 출석 알림" />

                    <TextView
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="놓친 날을 채울 수 있으면 알려 드려요. 알림을 누르면 바로 보충해요." />
                </LinearLayout>

                <com.lesumein.hoyocheckin.StarSwitch
                    android:id="@+id/makeUpSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowOpenPage"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="출석 페이지 열기" />

                    <TextView
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="캡차 때문에 자동 출첵이 막혔을 때 직접 눌러요" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAccount"
                style="@style/Row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/accountTitle"
                        style="@style/Text.RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/accountSub"
                        style="@style/Text.RowSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowLogout"
                style="@style/Row"
                android:minHeight="56dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이 계정 로그아웃"
                    android:textColor="@color/warn"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="호요랩 서버의 날짜가 바뀌는 순간(한국 시간 새벽 1시) 직후에 출석해요. 폰 시계가 틀려도 서버 시각에 맞춰요. 놓치면 6시간마다 다시 확인해요."
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
