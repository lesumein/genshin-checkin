<?xml version="1.0" encoding="utf-8"?>
<!-- '지금 픽업' 위젯: 4×2칸. 복각표 자료로 그리고, 남은 날이 바뀌도록 30분마다 다시 그린다. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_pickup_description"
    android:initialLayout="@layout/widget_pickup"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:previewLayout="@layout/widget_pickup"
