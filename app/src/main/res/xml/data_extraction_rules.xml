<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 클라우드 백업·기기 이전에서도 쿠키가 담긴 저장소를 빼낸다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
