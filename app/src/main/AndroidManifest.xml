<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 예약 작업을 '네트워크 연결됐을 때만' 돌리려면 필요하다. 없으면 최신 안드로이드는 예약할 때 앱을 멈춘다. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 서버 기준 새벽 1시 직후에 정확히 출석하기 위한 알람. 사용자가 설정에서 허용한다. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 절전 때문에 출석이 밀리지 않도록 배터리 최적화 예외를 요청한다. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- '원신 켜기'로 게임을 열려면 안드로이드 11부터는 그 앱이 깔려 있는지 볼 수 있게 밝혀 둬야 한다. -->
    <queries>
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.miHoYo.GI.samsung" />
    </queries>

    <!-- 쿠키가 백업으로 다른 기기에 넘어가지 않게 백업을 끈다. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HoyoCheckin">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RewardHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".RerunActivity"
            android:exported="false" />

        <activity
            android:name=".EventsActivity"
            android:exported="false" />

        <service
            android:name=".CheckInJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".DailyAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".RedeemAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".ResinWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/resin_widget_info" />
        </receiver>

        <receiver
            android:name=".NotesAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
